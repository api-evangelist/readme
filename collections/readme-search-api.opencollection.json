{
  "opencollection": "1.0.0",
  "info": {
    "name": "ReadMe Developer Metrics Analytics Search API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Search",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search Knowledge Base",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://metrics.readme.io/v1/search",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Search Knowledge Base"
        }
      ]
    }
  ],
  "bundled": true
}