{
  "opencollection": "1.0.0",
  "info": {
    "name": "ReadMe Developer Metrics Analytics API Keys API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "API Keys",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List API Keys",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://metrics.readme.io/v1/apikeys"
          },
          "docs": "List API Keys"
        },
        {
          "info": {
            "name": "Create An API Key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://metrics.readme.io/v1/apikeys"
          },
          "docs": "Create An API Key"
        },
        {
          "info": {
            "name": "Delete An API Key",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://metrics.readme.io/v1/apikeys/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete An API Key"
        }
      ]
    }
  ],
  "bundled": true
}