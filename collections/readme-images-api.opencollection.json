{
  "opencollection": "1.0.0",
  "info": {
    "name": "ReadMe Developer Metrics Analytics Images API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Images",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Upload An Image",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://metrics.readme.io/v1/images"
          },
          "docs": "Upload An Image"
        }
      ]
    }
  ],
  "bundled": true
}